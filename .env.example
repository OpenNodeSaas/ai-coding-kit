# ================= 1. Claude Code CLI（聚合商 A）=================
# 注意：Claude Base URL 末尾一般不要带 /v1
CLAUDE_AGGREGATOR_URL="https://你的Claude聚合商域名"
CLAUDE_AGGREGATOR_API_KEY="sk-你的Claude聚合商Key"
CLAUDE_MODEL="claude-sonnet-5-5"
CLAUDE_OPUS_MODEL="claude-opus-5-5"
# Claude 后台子 Agent 与轻量任务模型（填聚合商 A 里最便宜的模型，如 claude-haiku-4-5 或 deepseek-flash）
CLAUDE_FAST_MODEL="deepseek-flash"

# ================= 2. Codex CLI 主渠道（聚合商 B - OpenAI）=================
# 注意：Codex Base URL 需要带 /v1，且该聚合商需支持 /v1/responses
CODEX_AGGREGATOR_URL="https://你的OpenAI聚合商域名/v1"
CODEX_AGGREGATOR_API_KEY="sk-你的OpenAI聚合商Key"
CODEX_MODEL="gpt-6-sol"

# ================= 3. Codex CLI 副渠道（DeepSeek 官方）=================
DEEPSEEK_API_KEY="sk-你的DeepSeek官方Key"
DEEPSEEK_MODEL="deepseek-flash"

# ================= 4. 全局 Ponytail 默认模式 =================
# 可选：lite | full | ultra | off
PONYTAIL_DEFAULT_MODE="full"
